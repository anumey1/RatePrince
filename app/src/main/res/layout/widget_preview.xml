<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ picker preview, inflated live by the launcher. Mirrors the 3x2 StackedLayout
     with a representative conversion, because an empty box doesn't sell the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_local"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_amount"
        android:textColor="@color/widget_on_surface"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_home"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_result"
        android:textColor="@color/widget_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="@string/widget_preview_caption"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
